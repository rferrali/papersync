{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "libraries": {
        "type": "object",
        "patternProperties": {
          "^[a-zA-Z0-9._-]+$": { "type": "string" }
        },
        "additionalProperties": false
      },
      "projects": {
        "type": "object",
        "patternProperties": {
          "^[a-zA-Z0-9._-]+$": {
            "type": "object",
            "properties": {
              "local": { "type": "string" },
              "remote": { "type": "string" },
              "libraries": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["local"],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "required": ["projects"],
    "additionalProperties": false
  }